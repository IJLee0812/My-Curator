# My-Curator environment variables.
# Copy to .env and fill in real values:  cp .env.example .env

# ─── Pipeline runtime (DeepStream-VLM baseline) ────────────────────────
# HuggingFace token (optional, for BF16 model download)
HF_TOKEN=your_huggingface_token_here
# Display (GUI output, optional)
DISPLAY=${DISPLAY}
# NGC_API_KEY is entered interactively inside the container via `ngc config set`.

# ─── Storage tri-stack (P1-2 — infra/compose.base.yml) ────────────────
# Absolute path on the host where service data dirs live:
#   ${DATA_ROOT}/minio, ${DATA_ROOT}/pg, ${DATA_ROOT}/milvus, ${DATA_ROOT}/etcd
# Use a LOCAL SSD path (not NAS) — these are performance-sensitive volumes.
DATA_ROOT=/srv/my-curator

# MinIO root credentials (also used by Milvus to read/write its `milvus/` bucket).
MINIO_USER=minio-admin
MINIO_PASSWORD=change-me-please

# PostgreSQL superuser credentials for the `curation` DB.
PG_USER=curation
PG_PASSWORD=change-me-please
