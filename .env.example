# My-Curator environment variables.
# Copy to .env and fill in real values:  cp .env.example .env

# ─── Pipeline runtime (DeepStream-VLM baseline) ────────────────────────
# HuggingFace token (optional, for BF16 model download)
HF_TOKEN=your_huggingface_token_here
# Display (GUI output, optional)
DISPLAY=${DISPLAY}
# NGC_API_KEY is entered interactively inside the container via `ngc config set`.

# ─── Storage tri-stack (P1-2 — infra/compose.base.yml) ────────────────
# Absolute path on the host where service data dirs live:
#   ${DATA_ROOT}/minio, ${DATA_ROOT}/pg, ${DATA_ROOT}/milvus, ${DATA_ROOT}/etcd
# Use a LOCAL SSD path — these are performance-sensitive volumes.
DATA_ROOT=/srv/my-curator

# MinIO root credentials (also used by Milvus to read/write its `milvus/` bucket).
MINIO_USER=minio-admin
MINIO_PASSWORD=change-me-please

# PostgreSQL superuser credentials for the `curation` DB.
PG_USER=curation
PG_PASSWORD=change-me-please

# ─── Video data root (P3-4 — dataset root / KITTI / nuScenes streaming) ───
# Absolute path on the host that contains the source video files.
# Mounted read-only at /video_data inside curation-api, and at the same path
# inside the DS pipeline container (network_mode: host).
# NEVER commit the real path — keep it in .env (gitignored).
VIDEO_DATA_ROOT=/path/to/video/data/root

# Session identifier used by the DS pipeline for MinIO frame key prefix.
# frames/{CURATOR_SESSION_ID}/{clip_id}/frame_0..7.jpg
# Set to something meaningful per ingest run (e.g. the session directory name).
CURATOR_SESSION_ID=my-session

# ─── CARLA simulation (P5-1 — infra/compose.simulate.yml) ────────────────
# Host-side ports only; the container always listens on 2000-2002 (RPC) and
# 6080 (viewer). Override when the defaults are already bound on the host —
# keep the range 3 wide so the client's rpc+1 streaming port still maps.
# Where generated scenarios are written, and what the simulator sees read-only at
# /opt/sim. Defaults to ${DATA_ROOT}/sim.
#SIM_ARTIFACT_DIR=
# Where rendered video is written — the simulator's only writable mount, /opt/render.
# Defaults to ${DATA_ROOT}/render.
#SIM_RENDER_DIR=

CARLA_HOST_PORTS=2000-2002
CARLA_NOVNC_PORT=6080

# CARLA_VIEWER=1 starts Xvfb + x11vnc + noVNC; 0 runs with -RenderOffScreen.
CARLA_VIEWER=1
CARLA_QUALITY=Low
CARLA_RESOLUTION=800x600
